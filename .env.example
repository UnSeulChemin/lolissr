# Configuration de LoliSSR
# Copier .env.example vers .env et renseigner les accès à la base.
# Les identifiants HTTP sont nécessaires uniquement pour les tests.

# APPLICATION
# APP_ENV : local, testing ou production.
# testing utilise des transactions en lecture seule, sans changer de base.
APP_NAME=LoliSSR
APP_VERSION=6.0.0
APP_ENV=local
# Chemin du site : /lolissr en sous-dossier, / à la racine.
APP_BASE_URI=/lolissr
APP_TIMEZONE=Europe/Paris
# Nombre d’éléments par page.
APP_PAGINATION=8

# DÉVELOPPEMENT
# En production, desactiver debug, profiler et inscription ; SQL reste reserve au compte 1.
APP_DEBUG=true
PROFILER_ENABLED=true
SQL_TOOL_ENABLED=true
REGISTRATION_ENABLED=false

# CONNEXION ET SESSION
# Activer uniquement derrière un proxy de confiance.
TRUST_PROXY=false
SESSION_NAME=LOLISSR_SESSION

# BASE DE DONNÉES
# DB_HOST, DB_PORT, DB_NAME et DB_USER sont obligatoires.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
# Seuil des requêtes lentes, en millisecondes.
DB_SLOW_QUERY_THRESHOLD=50

# CACHE
CACHE_ENABLED=true
# Durée de conservation par défaut, en secondes.
CACHE_TTL=300

# LOGS
LOG_ENABLED=true
# Durée de conservation, en jours.
LOG_RETENTION_DAYS=14

# IMAGES ENVOYÉES
# Taille maximale en octets : 5242880 = 5 Mio.
UPLOAD_MAX_SIZE=5242880
# Dimensions en pixels et nombre maximal de pixels.
UPLOAD_MAX_WIDTH=10000
UPLOAD_MAX_HEIGHT=10000
UPLOAD_MAX_PIXELS=50000000
# Listes séparées par des virgules.
UPLOAD_ALLOWED_EXT=jpg,jpeg,png,webp
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp

# SAUVEGARDES
# Chemin complet de mysqldump, obligatoire pour composer backup.
MYSQLDUMP_PATH=

# TESTS HTTP
# Identifiants d’un compte existant utilisé par les tests.
HTTP_TEST_USERNAME=
HTTP_TEST_PASSWORD=

# PHP CLI pour les commandes admin
ADMIN_COMMAND_PHP=
