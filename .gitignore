# Environnement local (conserver le modele de configuration)
.env
.env.*
!.env.example

# Dependances et outils installes localement
/vendor/
/storage/tools/

# Donnees d'execution
/storage/bootstrap/
/storage/cache/*
!/storage/cache/.gitkeep
/storage/sessions/*
!/storage/sessions/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/backups/*
!/storage/backups/.gitkeep

# Etat local des builds et de la retention JavaScript
/storage/.build.lock
/storage/javascript-retention.json
/storage/thumbnail-optimization.json
/storage/grid-images/
/storage/profile-images.json
/storage/manga-releases.json
/storage/manga-recommendations.json
/storage/manga-releases.lock

# Images locales et fichiers envoyes par les utilisateurs
/public/images/*
!/public/images/.gitkeep

# Archives de livraison
/releases/*
!/releases/.gitkeep
*.zip
*.rar
*.7z

# Rapports des tests HTTP
/tests/Http/reports/*
!/tests/Http/reports/.gitkeep

# Fichiers temporaires laisses par un build interrompu
/Config/**/.build-*
/scripts/Assets/**/.build-*
/public/css/.build-*
/public/js/.build-*
/public/js/dist/**/.build-*
/storage/.build-*

# Les sources scripts/ et tests/ restent suivies.
# Les assets publies restent suivis : public/css/, public/js/dist/,
# Config/assets/versions.php et Config/assets/javascript-manifest.php. Conserver composer.lock.

# Notes personnelles et fichiers temporaires d'editeur
/roadmap.txt
/MANGACOLLEC-API.txt
/AVANT-PRODUCTION.txt
*.swp
*.swo
*~

# Configuration locale des IDE
/.idea/
/.vscode/

# Fichiers du systeme d'exploitation
.DS_Store
Thumbs.db
desktop.ini

/storage/manga-recommendations-hidden-*.json
/storage/manga-recommendations-hidden-*.json.lock
/storage/manga-recommendations.lock
