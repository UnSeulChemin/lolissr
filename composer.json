{
    "name": "lolissr/lolissr",
    "description": "Site personnel",
    "license": "proprietary",
    "type": "project",

    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },

    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0"
    },

    "autoload": {
        "psr-4": {
            "App\\": "App/",
            "Framework\\": "Framework/"
        }
    },

    "scripts": {
        "check": ["@phpstan", "@http-tests", "@regression-tests"],
        "check:all": ["@check", "@browser-tests"],

        "phpstan": "phpstan analyse --no-progress --memory-limit=512M",
        "http-tests": ["@php tests/Http/run-http.php", "@php tests/Http/spa-http.php"],
        "browser-tests": "@php tests/Browser/run-browser-tests.php",
        "dx": "@php scripts/Tools/dx-format.php",
        "dx:check": "@php scripts/Tools/dx-format.php --check",
        "regression-tests": [
            "@php tests/Build/project-structure.php",
            "@php tests/Framework/configuration.php",
            "@php tests/Framework/configuration-files.php",
            "@php tests/Framework/routing.php",
            "@php tests/Framework/cache-contention.php",
            "@php tests/Framework/bootstrap-cache.php",
            "@php tests/Framework/production-errors.php",
            "@php tests/Framework/cache-expiration-race.php",
            "@php tests/Framework/cache-ttl.php",
            "@php tests/Framework/flash-toast.php",
            "@php tests/Framework/request-lifecycle.php",
            "@php tests/Framework/core-behavior.php",
            "@php tests/Domain/achievement-xp.php",
            "@php tests/Domain/app-boundaries.php",
            "@php tests/Domain/collection-delete-identity.php",
            "@php tests/Domain/collection-update-existence.php",
            "@php tests/Domain/media-integrity.php",
            "@php tests/Domain/manga-xp-batch.php",
            "@php tests/Domain/collection-xp-batch.php",
            "@php tests/Domain/profile-read-only.php",
            "@php tests/Domain/collection-projections.php",
            "@php tests/Domain/collectible-search.php",
            "@php tests/Domain/flashcard-pages.php",
            "@php tests/Domain/bounded-content.php",
            "@php tests/Domain/bounded-content.php mysql",
            "@php tests/Domain/flashcard-snapshot.php",
            "@php tests/Domain/login-throttle-identity.php",
            "@php tests/Domain/manga-filtered-pages.php",
            "@php tests/Assets/css-bundle.php",
            "@php tests/Assets/page-styles.php",
            "@php tests/Assets/asset-versions.php",
            "@php tests/Assets/javascript-bundle.php",
            "@php tests/Assets/javascript-retention.php",
            "@php tests/Build/atomic-file.php",
            "@php tests/Build/dx-format.php",
            "@php tests/Build/release-archive.php",
            "@php tests/Build/build-lock.php"
        ],

        "assets:build": "@php scripts/Assets/build-assets.php",
        "css:build": "@php scripts/Assets/build-css.php",
        "js:install": "@php scripts/Assets/install-esbuild.php",
        "js:build": "@php scripts/Assets/build-js.php",
        "js:prune": "@php scripts/Assets/prune-javascript.php",
        "images:build": "@php scripts/Assets/build-profile-images.php",

        "dev:reset": ["@logs:clear", "@cache:clear", "@sessions:clear", "@composer dump-autoload"],
        "logs:clear": "@php scripts/Maintenance/clear-runtime.php logs",
        "cache:clear": "@php scripts/Maintenance/clear-runtime.php cache",
        "sessions:clear": "@php scripts/Maintenance/clear-runtime.php sessions",
        "bootstrap:cache": "@php scripts/Maintenance/bootstrap-cache.php build",
        "bootstrap:clear": "@php scripts/Maintenance/bootstrap-cache.php clear",

        "backup": "@php scripts/Database/backup-database.php",
        "db:deduplicate-indexes": "@php scripts/Database/deduplicate-indexes.php",
        "xp:backfill": "@php scripts/Profile/backfill-achievement-xp.php",

        "release:zip": "@php scripts/Release/build-release.php",
        "git:reset": "@php scripts/Maintenance/git-reset.php",
        "publish:git": "@php scripts/Release/publish-git.php"
    },

    "scripts-descriptions": {
        "dx": "[DX] Applique les conventions de presentation PHP, JavaScript et CSS.",
        "dx:check": "[DX] Detecte les ecarts de presentation sans modifier les sources.",
        "check": "[Tests] Analyse PHP + tests HTTP et régression.",
        "check:all": "[Tests] Tous les contrôles, navigateur compris.",

        "phpstan": "[Tests] Analyse statique du code PHP.",
        "http-tests": "[Tests] Vérifie les réponses HTTP et la navigation SPA.",
        "browser-tests": "[Tests] Lance les tests dans le navigateur.",
        "regression-tests": "[Tests] Vérifie le framework, les fonctionnalités et les builds.",

        "assets:build": "[Build] Compile CSS et JavaScript, puis actualise leurs versions.",
        "css:build": "[Build] Compile les styles CSS.",
        "js:install": "[Build] Installe esbuild pour compiler le JavaScript.",
        "js:build": "[Build] Compile les fichiers JavaScript.",
        "js:prune": "[Build] Supprime les anciens bundles JavaScript après leur délai de rétention.",
        "images:build": "[Build] Génère les images de profil.",

        "dev:reset": "[Nettoyage] Vide logs, cache et sessions, puis régénère l’autoload.",
        "logs:clear": "[Nettoyage] Vide les logs.",
        "cache:clear": "[Nettoyage] Vide le cache.",
        "sessions:clear": "[Nettoyage] Supprime les sessions.",
        "bootstrap:cache": "[Production] Compile configuration et routes sur le serveur cible.",
        "bootstrap:clear": "[Nettoyage] Desactive le cache de configuration et routes.",

        "backup": "[Données] Sauvegarde la base de données.",
        "db:deduplicate-indexes": "[Données] Gère les index redondants de la base.",
        "xp:backfill": "[Données] USER_ID [--apply] : audite les XP ; --apply ajoute les récompenses manquantes.",

        "release:zip": "[Publication] Crée une archive ZIP de livraison.",
        "git:reset": "[Git] Annule les modifications locales et supprime les fichiers non suivis (hors fichiers ignorés).",
        "publish:git": "[Publication] Compile les assets et publie les changements avec Git."
    }
}
